# ─────────────────────────────────────────────────────────────────────────────
# Jobster Serverless — Environment Variables
# Copy to .env for local development (SAM local invoke reads this via --env-vars)
# In production, these are injected by SAM via template.yaml Environment section
# ─────────────────────────────────────────────────────────────────────────────

# JWT Configuration (same values as your Express app .env)
JWT_SECRET=
JWT_LIFETIME=1d

# DynamoDB Table name (populated automatically by SAM in production)
TABLE_NAME=Jobster

# AWS Region
AWS_REGION=ap-south-1

# For local DynamoDB (when using amazon/dynamodb-local Docker image)
# Uncomment these when running sam local start-api with DynamoDB Local
# DYNAMODB_ENDPOINT=http://localhost:8000
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local
